{{#if aiContent.highlights.length}}
<div class="highlight-section">
  <div class="highlight-header">
    <span class="highlight-header-title">{{i18n.sectionHighlights}}</span>
    <span class="highlight-header-count">{{itemsCount aiContent.highlights.length}}</span>
  </div>

  <div class="highlight-grid">
  {{#each aiContent.highlights}}
  <div class="highlight-card">
    <div class="highlight-heading">
      <span class="highlight-badge highlight-{{this.type}}">{{this.type}}</span>
      {{#if this.url}}
      <div class="highlight-title"><a href="{{this.url}}" target="_blank" rel="noopener nofollow">{{this.title}}</a></div>
      {{else}}
      <div class="highlight-title">{{this.title}}</div>
      {{/if}}
    </div>
    <div class="highlight-meta">
      <span class="github-entity highlight-meta-repo">{{> github-mark}}<span class="highlight-meta-name">{{this.repo}}</span></span>
      <span class="highlight-meta-tail">&middot; {{{colorizeLineStats this.meta}}}</span>
    </div>
  </div>
  {{/each}}
  </div>
</div>
{{/if}}

{{#if calculator}}
{{#with calculator}}
<section class="section-group est{{#if ../standalone}} est-standalone{{/if}}" {{#unless ../standalone}}aria-labelledby="est-title" {{/unless}}{{#if ../standalone}}aria-label="Planning calculator" {{/if}}data-est-root>
  {{#unless ../standalone}}
  <div class="section-group-header">
    <h2 class="section-group-title" id="est-title">How long would it take?</h2>
    <div class="section-group-line"></div>
  </div>
  <p class="est-intro">Pick the kind of work to see a planning range based on past delivery, alongside estimated effort without AI assistance.</p>
  {{/unless}}
  <form class="est-form" autocomplete="off">
    <label class="est-field"><span class="est-label">What kind of work</span>
      <select class="est-select" name="kind" id="est-kind">
        <option value="bug-fix">Bug fix</option>
        <option value="change">Small change</option>
        <option value="feature" selected>New feature</option>
        {{#if hasApps}}<option value="app">New app or product</option>{{/if}}
      </select>
      {{#unless hasApps}}<span class="est-caption">App estimates appear once there's enough history from past apps.</span>{{/unless}}
    </label>
    <label class="est-field" data-est-size><span class="est-label">How big</span>
      <select class="est-select" name="size">
        <option value="S">One small piece (a tweak to one screen)</option>
        <option value="M" selected>A screen or a flow</option>
        <option value="L">Several screens + data changes</option>
        <option value="XL">A whole new area</option>
      </select>
    </label>
    <label class="est-field"><span class="est-label">Have I done something like this before</span>
      <select class="est-select" name="familiar">
        <option value="0" selected>Yes, familiar</option>
        <option value="1">Partly new</option>
        <option value="2">Brand new</option>
      </select>
    </label>
    <label class="est-field"><span class="est-label">Outside systems to connect (APIs, vendors, other apps)</span>
      <select class="est-select" name="integrations">
        <option value="0" selected>None</option>
        <option value="1">One</option>
        <option value="2">Two or more</option>
      </select>
    </label>
    <label class="est-field"><span class="est-label">Target</span>
      <select class="est-select" name="target">
        <option value="prototype">Working prototype</option>
        <option value="production" selected>Production-ready</option>
      </select>
    </label>
  </form>
  <div class="est-output" aria-live="polite">
    <p class="est-primary" data-est-primary></p>
    <p class="est-secondary" data-est-secondary></p>
    <p class="est-basis" data-est-basis></p>
    <ul class="est-ref" data-est-ref hidden></ul>
    <p class="est-caption">A planning range from past work, not a deadline. Unknowns found during discovery can change it.</p>
  </div>
  <details class="est-details">
    <summary>How this is calculated</summary>
    <p>It uses {{sampleSize}} changes I completed since {{sinceLabel}}, grouped by kind of work and how many files they touched.</p>
    <p>The planning range is historical turnaround from first activity to code integration, counted in working days. "Likely" is the typical (P50) outcome and "allow up to" is the slow-end (P90) outcome.</p>
    <p>Equivalent manual effort is a modeled baseline for one engineer delivering the same changes without AI assistance. It is not actual hours worked or measured time saved.</p>
    <p>Adjustments for familiarity, outside systems and prototype versus production are rules of thumb, not measurements.</p>
    <p>When few similar changes exist, the comparison widens to nearby sizes and says so.</p>
  </details>
  <script type="application/json" id="est-data">{{{json}}}</script>
  <script>{{{script}}}</script>
</section>
{{/with}}
{{/if}}

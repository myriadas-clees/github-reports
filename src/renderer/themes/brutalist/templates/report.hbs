<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <title>{{aiContent.title}}</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{aiContent.subtitle}}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta property="og:title" content="{{aiContent.title}}" />
  <meta property="og:description" content="{{aiContent.subtitle}}" />
  <meta property="og:image" content="{{{ogImageUrl}}}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="article" />
  {{#if canonicalUrl}}<meta property="og:url" content="{{{canonicalUrl}}}" />
  {{/if}}<meta property="og:site_name" content="{{username}} Daily Reports" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{aiContent.title}}" />
  <meta name="twitter:description" content="{{aiContent.subtitle}}" />
  <meta name="twitter:image" content="{{{ogImageUrl}}}" />
  <meta name="author" content="{{username}}" />
  <meta name="theme-color" content="{{themeColor}}" />
  <meta property="article:published_time" content="{{dateRange.to}}" />
  <meta property="article:author" content="https://github.com/{{username}}" />
  <link rel="icon" href="{{avatarUrl}}" />
  {{#if canonicalUrl}}<link rel="canonical" href="{{{canonicalUrl}}}" />
  {{/if}}{{#if baseUrl}}<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{{baseUrl}}}/feed.xml" />
  {{/if}}<meta name="view-transition" content="same-origin" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{jsonLdEscape aiContent.title}}",
    "description": "{{jsonLdEscape aiContent.subtitle}}",
    "author": {
      "@type": "Person",
      "name": "{{jsonLdEscape username}}",
      "url": "https://github.com/{{jsonLdEscape username}}"
    },
    "image": "{{jsonLdEscape ogImageUrl}}",
    "datePublished": "{{jsonLdEscape dateRange.to}}"
  }
  </script>
  {{#if canonicalUrl}}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{jsonLdEscape baseUrl}}/" },
      { "@type": "ListItem", "position": 2, "name": "{{jsonLdEscape dateRange.from}} - {{jsonLdEscape dateRange.to}}", "item": "{{jsonLdEscape canonicalUrl}}" }
    ]
  }
  </script>
  {{/if}}
  <style>{{{css}}}</style>
  {{{themeInitScript}}}
</head>
<body>

<a href="#main-content" class="skip-link">Skip to content</a>

<nav aria-label="Site navigation">
  <div class="nav-inner">
    <a href="../../" class="nav-brand">
      <img class="nav-logo nav-logo-light" src="../../assets/brand/myriad-m-mark.png" alt="Myriad" width="22" height="22" />
      <img class="nav-logo nav-logo-dark" src="../../assets/brand/myriad-m-mark-dark.png" alt="" width="22" height="22" />
      <span class="nav-site-title">{{siteTitleInline}}</span>
    </a>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
        <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
      </button>
    </div>
  </div>
</nav>

<div class="report-hero">
  <div class="report-hero-inner">
    <a href="../../" class="report-back">&larr; {{i18n.allWeeks}}</a>
    {{> header}}
  </div>
</div>

<main id="main-content">
<article class="page">
  {{> overview}}
  {{> activity}}
  {{> highlights}}
</article>
</main>

{{#if prevWeek}}{{#if nextWeek}}
<nav class="week-nav" aria-label="Week navigation">
  <a href="{{prevWeek}}" class="week-nav-link">&larr; {{i18n.prevWeek}}</a>
  <a href="{{nextWeek}}" class="week-nav-link">{{i18n.nextWeek}} &rarr;</a>
</nav>
{{else}}
<nav class="week-nav" aria-label="Week navigation">
  <a href="{{prevWeek}}" class="week-nav-link">&larr; {{i18n.prevWeek}}</a>
  <span></span>
</nav>
{{/if}}{{else}}{{#if nextWeek}}
<nav class="week-nav" aria-label="Week navigation">
  <span></span>
  <a href="{{nextWeek}}" class="week-nav-link">{{i18n.nextWeek}} &rarr;</a>
</nav>
{{/if}}{{/if}}

{{> footer}}

{{{themeToggleScript}}}
</body>
</html>

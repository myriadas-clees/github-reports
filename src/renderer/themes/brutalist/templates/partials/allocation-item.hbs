<li>{{#if impact}}<span class="alloc-impact alloc-impact--{{impact}}">{{impactLabel}}</span>{{/if}}{{#if url}}<a href="{{url}}" target="_blank" rel="noopener nofollow">{{title}}</a>{{else}}{{title}}{{/if}}{{#if readiness}}<span class="alloc-stage alloc-stage--{{readiness.stage}}"{{#if readiness.detail}} title="{{readiness.detail}}"{{/if}}>{{readiness.label}}{{#if readiness.detail}}<span class="alloc-sr"> ({{readiness.detail}})</span>{{/if}}</span>{{/if}}{{#if complexity}}<span class="alloc-cx alloc-cx--{{complexity.level}}{{#if complexity.partial}} alloc-cx--partial{{/if}}" title="{{complexity.reason}}">{{complexity.label}}<span class="alloc-sr"> ({{complexity.reason}})</span></span>{{#each complexity.risks}}<span class="alloc-risk">{{this}}</span>{{/each}}{{/if}}{{#if selfReported}}<span class="alloc-tag alloc-tag--self">Self-reported</span>{{/if}}{{#if repository}}<span class="alloc-repo">{{repository}}</span>{{/if}}{{#if checksText}}<span class="alloc-checks">{{checksText}}</span>{{/if}}</li>

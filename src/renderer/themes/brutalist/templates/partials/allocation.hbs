{{#if allocation}}
{{#with allocation}}
<section class="section-group alloc" aria-labelledby="alloc-title" data-alloc-root>
  <div class="section-group-header">
    <h2 class="section-group-title" id="alloc-title">{{title}}</h2>
    <div class="section-group-line"></div>
  </div>
  {{#if @root.weekLink}}<p class="week-link"><a href="{{@root.weekLink.href}}">{{@root.weekLink.text}}</a></p>{{/if}}
  {{#if hasSwitch}}
  <div class="alloc-switch" role="tablist" aria-label="Period">
    {{#each panels}}
    <button type="button" class="alloc-switch-opt" role="tab" id="{{id}}-tab" data-alloc-tab="{{id}}" aria-controls="{{id}}" aria-selected="{{#if isDefault}}true{{else}}false{{/if}}" tabindex="{{#if isDefault}}0{{else}}-1{{/if}}">{{label}}</button>
    {{/each}}
  </div>
  {{/if}}

  {{#each panels}}
  {{> allocation-panel hasSwitch=../hasSwitch}}
  {{/each}}

  {{#if hasTrend}}
  <div class="alloc-block alloc-trend-block">
    <h3 class="alloc-sub"><span>Last {{trendRows.length}} weeks</span><span class="alloc-sub-meta">share of each week's delivered work</span></h3>
    <ol class="alloc-trend">
      {{#each trendRows}}
      <li class="alloc-trend-row{{#if isCurrent}} is-current{{/if}}">
        <span class="alloc-trend-label">{{label}}{{#if isCurrent}} (so far){{/if}}</span>
        <span class="alloc-trend-bar">
          {{#if bar.segments.length}}
          <span class="alloc-bar alloc-bar--trend" role="img" aria-label="{{bar.ariaLabel}}">
            {{#each bar.segments}}<span class="alloc-seg {{colorClass}}" style="--grow:{{grow}}" title="{{title}}"></span>{{/each}}
          </span>
          {{else}}
          <span class="alloc-trend-empty">{{emptyText}}</span>
          {{/if}}
        </span>
        <span class="alloc-trend-total">{{total}}</span>
      </li>
      {{/each}}
    </ol>
    <ul class="alloc-legend" aria-label="Initiative colors">
      {{#each trendLegend}}
      <li><span class="alloc-swatch {{colorClass}}" aria-hidden="true"></span><span>{{name}}</span></li>
      {{/each}}
    </ul>
    {{#if trendTable}}
    <details class="alloc-table-wrap">
      <summary>View as data table</summary>
      <div class="alloc-table-scroll">
        <table class="alloc-table">
          <caption class="alloc-sr">Share of work delivered per initiative, by work week</caption>
          <thead><tr>{{#each trendTable.headers}}<th scope="col">{{this}}</th>{{/each}}</tr></thead>
          <tbody>
            {{#each trendTable.rows}}
            <tr><th scope="row">{{label}}</th><td>{{days}}</td><td>{{total}}</td>{{#each cells}}<td>{{this}}</td>{{/each}}</tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </details>
    {{/if}}
  </div>
  {{/if}}

  <div class="alloc-foot">
    <p><strong class="alloc-foot-title">{{measureTitle}}.</strong> {{measureNote}}</p>
  </div>
  {{{script}}}
</section>
{{/with}}
{{/if}}

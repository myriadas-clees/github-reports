<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <title>Work week of {{label}} - {{siteTitleInline}}</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{description}}" />
  <meta property="og:title" content="Work week of {{label}}" />
  <meta property="og:description" content="{{description}}" />
  <meta property="og:type" content="article" />
  {{#if canonicalUrl}}<meta property="og:url" content="{{{canonicalUrl}}}" />
  <link rel="canonical" href="{{{canonicalUrl}}}" />{{/if}}
  <meta name="theme-color" content="{{themeColor}}" />
  {{#if avatarUrl}}<link rel="icon" href="{{avatarUrl}}" />{{/if}}
  {{#if baseUrl}}<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{{baseUrl}}}/feed.xml" />{{/if}}
  <link rel="preload" href="{{rootPrefix}}assets/fonts/roboto-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="{{rootPrefix}}assets/fonts/fonts.css" />
  <style>{{{css}}}</style>
  {{{themeInitScript}}}
</head>
<body>

<a href="#main-content" class="skip-link">Skip to content</a>

<nav aria-label="Site navigation">
  <div class="nav-inner">
    <a href="{{rootPrefix}}" class="nav-brand">
      <img class="nav-logo nav-logo-light" src="{{rootPrefix}}assets/brand/myriad-m-mark.png" alt="Myriad" width="22" height="22" />
      <img class="nav-logo nav-logo-dark" src="{{rootPrefix}}assets/brand/myriad-m-mark-dark.png" alt="Myriad" width="22" height="22" />
      <span class="nav-site-title">{{siteTitleInline}}</span>
    </a>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
        <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
      </button>
    </div>
  </div>
</nav>

<div class="report-hero">
  <div class="report-hero-inner">
<nav class="week-crumbs" aria-label="Breadcrumb">
  <a href="{{rootPrefix}}">&larr; All months</a>
  <span aria-hidden="true">/</span>
  <a href="{{rootPrefix}}#{{monthAnchor}}">{{monthLabel}}</a>
</nav>
<h1 class="header-title week-title">Work week of {{label}}{{#if open}} (so far){{/if}}</h1>
<p class="week-dates">{{from}} to {{to}} &middot; Thursday to Wednesday</p>
  </div>
</div>

<main id="main-content">
<article class="page">
  <nav class="week-days-section" aria-label="Daily reports this week">
    <span class="week-days-label">Daily reports</span>
    {{#if days.length}}<ul class="week-day-links">
      {{#each days}}<li><a href="{{this.href}}">{{this.label}}</a></li>{{/each}}
    </ul>{{else}}<p class="week-dates">No daily reports this week; effort is self-reported.</p>{{/if}}
  </nav>
  {{> allocation}}
  <nav class="week-pager" aria-label="Other work weeks">
    {{#if prev}}<a href="{{prev.href}}" rel="prev">&larr; {{prev.label}}</a>{{else}}<span></span>{{/if}}
    {{#if next}}<a href="{{next.href}}" rel="next">{{next.label}} &rarr;</a>{{else}}<span></span>{{/if}}
  </nav>
</article>
</main>

{{> footer}}

{{{themeToggleScript}}}
</body>
</html>

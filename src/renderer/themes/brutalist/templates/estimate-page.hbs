<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <title>{{pageTitle}}</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{description}}" />
  <meta property="og:title" content="{{pageTitle}}" />
  <meta property="og:description" content="{{description}}" />
  <meta property="og:type" content="website" />
  {{#if ogImageUrl}}<meta property="og:image" content="{{ogImageUrl}}" />{{/if}}
  {{#if baseUrl}}<meta property="og:url" content="{{baseUrl}}/estimate/" />{{/if}}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{pageTitle}}" />
  <meta name="twitter:description" content="{{description}}" />
  {{#if baseUrl}}<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{baseUrl}}/feed.xml" />{{/if}}
  <link rel="preload" href="../assets/fonts/roboto-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="../assets/fonts/fonts.css" />
  <style>{{{css}}}</style>
  <style>{{{indexCss}}}</style>
  {{{themeInitScript}}}
</head>
<body>

<nav class="index-nav">
  <div class="index-nav-inner">
    <a href="../" class="nav-brand">
      <img class="nav-logo nav-logo-light" src="../assets/brand/myriad-m-mark.png" alt="Myriad" width="22" height="22" />
      <img class="nav-logo nav-logo-dark" src="../assets/brand/myriad-m-mark-dark.png" alt="Myriad" width="22" height="22" />
      <span class="nav-site-title">{{siteTitleInline}}</span>
    </a>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
        <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
      </button>
    </div>
  </div>
</nav>

<main class="est-page">
  <a class="est-page-back" href="../">&larr; Back to the worklog</a>
  <h1 class="est-page-title">How long would it take?</h1>
  <p class="est-intro">Pick the kind of work to get a planning range based on my past delivery.</p>
  <div class="est-cards" role="group" aria-label="Kind of work">
    {{#each cards}}
    <button class="est-card" type="button" data-est-card="{{this.param}}" aria-pressed="false">{{this.label}}</button>
    {{/each}}
  </div>

  {{> estimate-calculator standalone=true}}

  <section class="est-excludes" aria-label="What this does not include">
    <h2>What this doesn't include</h2>
    <ul>
      <li>Discovery and design time before the work starts.</li>
      <li>Waiting on others: reviews, vendor access, decisions.</li>
      <li>A range is not a deadline.</li>
      <li>Whether the work is accepted by the client or meets our Definition of Done. <a href="../finished/">How we say something is finished</a>.</li>
    </ul>
  </section>
</main>

<footer class="footer">
  <div class="theme-toggle-row">
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
      <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
    </button>
  </div>
  Myriad Advisor Solutions
  &nbsp;&middot;&nbsp;
  <a href="https://myriadas.com" target="_blank" rel="noopener">myriadas.com</a>
</footer>

<script>{{{kindScript}}}</script>
{{{themeToggleScript}}}
</body>
</html>

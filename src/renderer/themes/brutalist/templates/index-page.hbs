<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <title>{{siteTitle}}</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{description}}" />
  <meta name="view-transition" content="same-origin" />
  <meta property="og:title" content="{{siteTitleInline}}" />
  <meta property="og:description" content="{{description}}" />
  <meta property="og:type" content="website" />
  {{#if ogImageUrl}}<meta property="og:image" content="{{ogImageUrl}}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />{{/if}}
  {{#if baseUrl}}<meta property="og:url" content="{{baseUrl}}/" />{{/if}}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{siteTitleInline}}" />
  <meta name="twitter:description" content="{{description}}" />
  {{#if ogImageUrl}}<meta name="twitter:image" content="{{ogImageUrl}}" />{{/if}}
  {{#if baseUrl}}<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{baseUrl}}/feed.xml" />{{/if}}
  <style>{{{css}}}</style>
  <style>{{{indexCss}}}</style>
  {{{themeInitScript}}}
</head>
<body>

<nav class="index-nav">
  <div class="index-nav-inner">
    <a href="./" class="nav-brand">
      <img class="nav-logo nav-logo-light" src="assets/brand/myriad-m-mark.png" alt="Myriad" width="22" height="22" />
      <img class="nav-logo nav-logo-dark" src="assets/brand/myriad-m-mark-dark.png" alt="" width="22" height="22" />
      <span class="nav-site-title">{{siteTitleInline}}</span>
    </a>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
        <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
        <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
      </button>
    </div>
  </div>
</nav>

<main class="overhead-shell">
  <header class="overhead-header">
    <div class="overhead-identity">
      <div class="overhead-kicker">Daily worklog / overhead</div>
      <h1 class="overhead-title">{{siteTitle}}</h1>
      <div class="overhead-owner">
        {{#if avatarUrl}}<img src="{{avatarUrl}}" alt="" class="overhead-avatar" width="32" height="32" />{{/if}}
        <span>{{displayName}}</span>
        {{#if username}}<a href="https://github.com/{{username}}" target="_blank" rel="noopener nofollow">@{{username}}</a>{{/if}}
      </div>
    </div>
    <div class="overhead-window">
      <span class="overhead-window-label">Reporting window</span>
      <strong>{{overview.rangeLabel}}</strong>
    </div>
  </header>

  <section class="overview-strip" aria-label="Archive totals">
    <div class="overview-cell">
      <span class="overview-value">{{overview.commits}}</span>
      <span class="overview-label">commits</span>
    </div>
    <div class="overview-cell">
      <span class="overview-value">{{overview.prs}}</span>
      <span class="overview-label">pull requests</span>
    </div>
    <div class="overview-cell">
      <span class="overview-value">{{overview.reviews}}</span>
      <span class="overview-label">reviews</span>
    </div>
  </section>

  <section class="ledger" aria-label="Daily report archive">
    <div class="ledger-heading">
      <span>Activity ledger</span>
      <span>{{overview.reportCount}} reports</span>
    </div>

    {{#each monthGroups}}
    <details class="month-group" {{#if @first}}open{{/if}}>
      <summary class="month-summary">
        <div class="month-name"><span>{{this.label}}</span><strong>{{this.year}}</strong></div>
        <div class="month-tape" aria-hidden="true">
          {{#each this.reports}}<i style="--activity: {{this.activityPercent}}%"></i>{{/each}}
        </div>
        <div class="month-totals">
          <span><b>{{this.stats.commits}}</b> commits</span>
          <span><b>{{this.stats.prs}}</b> PRs</span>
          <span><b>{{this.stats.reviews}}</b> reviews</span>
        </div>
        <span class="month-count" aria-label="Expand or collapse month"></span>
      </summary>

      <div class="day-list">
        {{#each this.reports}}
        <a href="{{this.path}}/" class="day-row">
          <div class="day-date"><strong>{{this.dayLabel}}</strong><span>{{this.weekdayLabel}}</span></div>
          <div class="day-story">
            <div class="day-title">{{#if this.title}}{{this.title}}{{else}}{{this.dateLabel}}{{/if}}</div>
            {{#if this.subtitle}}<div class="day-subtitle">{{this.subtitle}}</div>{{/if}}
          </div>
          {{#if this.stats}}
          <div class="day-stats">
            <span><b>{{this.stats.commits}}</b> C</span>
            <span><b>{{this.stats.prs}}</b> PR</span>
            <span><b>{{this.stats.reviews}}</b> R</span>
          </div>
          {{/if}}
          <span class="day-open" aria-hidden="true">↗</span>
        </a>
        {{/each}}
      </div>
    </details>
    {{/each}}
  </section>
</main>

<footer class="footer">
  <div class="theme-toggle-row">
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="theme-toggle-opt" data-mode="light" data-active="true"><span class="theme-toggle-glyph" aria-hidden="true">&#9728;&#65038;</span> Light</span>
      <span class="theme-toggle-opt" data-mode="dark" data-active="false"><span class="theme-toggle-glyph" aria-hidden="true">&#9790;&#65038;</span> Dark</span>
    </button>
  </div>
  Myriad Advisor Solutions
  &nbsp;&middot;&nbsp;
  <a href="https://myriadas.com" target="_blank" rel="noopener">myriadas.com</a>
</footer>

{{{themeToggleScript}}}
</body>
</html>

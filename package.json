{
  "name": "worklog",
  "version": "1.0.0",
  "description": "Private self-hosted daily GitHub status-page generator",
  "type": "module",
  "bin": {
    "worklog": "./dist/cli/index.js",
    "github-weekly-reporter": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "src/renderer/themes/",
    "assets/",
    "config.example.yaml"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "bun dist/cli/index.js report",
    "preview": "bun dist/cli/index.js preview"
  },
  "keywords": [
    "github",
    "daily-report",
    "worklog",
    "status-page",
    "private",
    "github-actions"
  ],
  "author": "worklog",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@inquirer/prompts": "^8.3.2",
    "@octokit/graphql": "^9.0.3",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "libsodium-wrappers": "^0.8.2",
    "marked": "^18.0.0",
    "openai": "^7.1.0",
    "sanitize-html": "^2.17.2",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^26.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.29.1",
    "vitest": "^4.1.2"
  }
}
